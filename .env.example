# ---- Devin v3 API ----
# Service-user API token (starts with cog_). The service user's role needs the
# ManageOrgSessions permission. Create at https://app.devin.ai/settings/api-keys
DEVIN_API_TOKEN=cog_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your organization ID (starts with org-)
DEVIN_ORG_ID=org-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: reusable playbook bundling repo conventions
# PLAYBOOK_ID=
# Safety cap on Agent Compute Units per session
MAX_ACU_LIMIT=25
# Optional: illustrative USD per ACU to show a $ cost view on the dashboard.
# Leave 0 to show ACUs only. Enterprise ACU rates are set per order form.
ACU_USD_RATE=0
# Demo mode: when the API reports 0 ACUs (self-serve accounts don't expose
# per-session ACUs), estimate them from session runtime so the cost view is
# populated. No-op on Enterprise, where real ACUs take precedence. See README
# "Demo mode & illustrative cost".
DEMO_MODE=false
# ACUs per active minute (~1 ACU / 15 min, Cognition's published rule of thumb).
ACU_PER_MINUTE=0.0667

# ---- GitHub ----
# Token with repo scope (read issues, comment, read PR/CI status)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# owner/repo the engine watches
GITHUB_REPO=shayaansultan/superset
# Shared secret configured on the GitHub webhook (leave blank to skip verification in dev)
GITHUB_WEBHOOK_SECRET=

# The label a human applies to an issue to request autonomous remediation
TRIGGER_LABEL=devin-autofix

# Rebuild the dashboard from Devin session tags on startup (near-stateless recovery).
# Set false to start empty, e.g. for a clean demo run.
REHYDRATE_ON_STARTUP=true

# ---- ngrok (only needed for the live webhook trigger) ----
# Auth token from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
